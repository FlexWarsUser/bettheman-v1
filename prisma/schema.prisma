generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  canLay       Boolean   @default(false)
  balance      Float     @default(0)
  weight       Float     @default(1)
  email        String?   @unique
  passwordHash String?
  role         String    @default("punter")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt 
    mustChangePassword Boolean @default(true)
}

model Bet {
  id                  Int       @id @default(autoincrement())
  punterId            Int
  punterName          String
  event               String
  selection           String
  odds                String
  stake               Float
  status              String    @default("pending")
  phase               String    @default("house_review")
  houseAction         String?
  houseAmount         Float     @default(0)
  residualStake       Float?
  eachWay        Boolean  @default(false)
originalStake  Float?
  houseTimerEnd       DateTime?
  layerTimerEnd       DateTime?
  houseActedAt        DateTime?
  acceptedAt          DateTime?
  layerBids           Json      @default("[]")
  allocationComplete  Boolean   @default(false)
  settledAt           DateTime?
  result              String?   // "won" | "lost" | "manual"
  settlementNotes     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
model LedgerEntry {
  id        Int      @id @default(autoincrement())
  betId     Int?
  eventType String
  actorId   Int?
  actorName String?
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([betId])
  @@index([eventType])
  @@index([createdAt])
}
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
model Event {
  id         Int      @id @default(autoincrement())
  type       String
  name       String
  date       DateTime
  runners Runner[]
  isHandicap Boolean  @default(false)
  fieldSize  Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model Runner {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String   // horse name
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([name])
}